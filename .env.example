# Copy to .env for local setup. Do not commit secrets.
PORT=3000
SITE_URL=https://your-domain.example
CONTACT_PHONE=
LEGAL_LOCKSMITH_NAME=Citywide Roadside Lock & Key
LICENSE_NUMBER=
SERVICE_REGION=Harford County, Baltimore County & Baltimore City, Maryland
CONTACT_EMAIL=

# All four below must be set to accept REAL requests.
ENABLE_LIVE_SUBMISSIONS=false
DATABASE_URL=
ADMIN_USERNAME=dispatch
ADMIN_PASSWORD=

# Optional instant dispatch alerts; configure one or both.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
RESEND_API_KEY=
FROM_EMAIL=
DISPATCH_EMAIL=
